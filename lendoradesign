<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Lendora ® — Design System v2.4 · Handoff Board</title>
<style>
/* ============================================================
   LENDORA DESIGN SYSTEM — DOCUMENTATION BOARD
   Self-contained handoff file. Tokens == production tokens.
   ============================================================ */
@font-face {
  font-family: "Outfit";
  font-style: normal;
  font-weight: 200 700;
  font-display: swap;
  src: url(data:font/woff2;base64,) format("woff2");
}

:root {
  /* ---- primitive: grayscale ---- */
  --g-100:#F6F7F9; --g-200:#ECEEF1; --g-300:#DCDFE4; --g-400:#C4C8CE; --g-500:#9EA3AA;
  --g-600:#5F646B; --g-700:#3A3E45; --g-800:#24272C; --g-900:#16181C;
  /* ---- primitive: primary gold ---- */
  --am-100:#FDF6E3; --am-200:#FBE6A4; --am-300:#F9D97E; --am-400:#F6CE5F; --am-500:#F4C74B;
  --am-600:#F0A93B; --am-700:#D98A21; --am-800:#A96613; --am-900:#7A4A0E;
  /* ---- primitive: coral ---- */
  --co-100:#FEECEA; --co-200:#FCD6D2; --co-300:#FBB0A8; --co-400:#FA8B7E; --co-500:#FA6C5D;
  --co-600:#E8503F; --co-700:#C43A2B; --co-800:#96291D; --co-900:#6B1D14;
  /* ---- primitive: periwinkle ---- */
  --pe-100:#F2F5FC; --pe-200:#E6EBF9; --pe-300:#DDE4F8; --pe-400:#C9D5F2; --pe-500:#AEBEE9;
  --pe-600:#8CA0DC; --pe-700:#6B81C4; --pe-800:#4E62A2; --pe-900:#38487A;
  /* ---- primitive: mint ---- */
  --mi-100:#EFF6F1; --mi-200:#DFEDE4; --mi-300:#CFE3D6; --mi-400:#A9CDB6; --mi-500:#7BB694;
  --mi-600:#579973; --mi-700:#417C5C; --mi-800:#2F5C44; --mi-900:#224332;
  /* ---- primitive: cream ---- */
  --cr-100:#FDFCF7; --cr-200:#FBF7E9; --cr-300:#F7EFDA; --cr-400:#F1E4C4; --cr-500:#E9D6A6;
  --cr-600:#D9BE7F; --cr-700:#B99C5B; --cr-800:#8C7340; --cr-900:#64522C;

  /* ---- semantic ---- */
  --ink:#16181C; --ink-2:#5F646B; --muted:#9EA3AA; --faint:#C4C8CE;
  --canvas:#ECEFF4; --cream:#FBF7E9; --amber:#F4C74B; --amber-deep:#F0A93B;
  --coral:#FA6C5D; --peri:#DDE4F8; --mint:#CFE3D6;
  --hair:rgba(22,24,28,.07); --hair-strong:rgba(22,24,28,.14);
  --surface-1:linear-gradient(180deg,rgba(255,255,255,.86),rgba(255,255,255,.58));
  --surface-2:rgba(255,255,255,.62);
  --surface-cream:linear-gradient(175deg,rgba(255,255,255,.9) 12%,rgba(252,247,231,.94));
  --border-surface:rgba(255,255,255,.85);
  --overlay:rgba(22,24,28,.30);
  --focus:#F0A93B;
  --ok-bg:#CFE3D6; --ok-text:#2F4A39; --ok-line:#7BB694;
  --warn-bg:#F4C74B; --warn-text:#16181C; --warn-line:#F0A93B;
  --err-bg:#FA6C5D; --err-text:#FFFFFF; --err-line:#E8503F;
  --info-bg:#DDE4F8; --info-text:#38487A; --info-line:#AEBEE9;

  /* ---- space / radius / elevation ---- */
  --sp-05:2px; --sp-1:4px; --sp-2:8px; --sp-3:12px; --sp-4:16px; --sp-5:20px; --sp-6:24px;
  --sp-8:32px; --sp-10:40px; --sp-12:48px; --sp-16:64px;
  --r-4:4px; --r-10:10px; --r-13:13px; --r-18:18px; --r-22:22px; --r-24:24px; --r-28:28px; --r-full:999px;
  --e-1:0 1px 2px rgba(22,24,28,.035);
  --e-2:0 1px 2px rgba(22,24,28,.035), 0 16px 40px -22px rgba(22,24,28,.22);
  --e-3:0 24px 60px -20px rgba(22,24,28,.35);
  --e-4:0 40px 90px -30px rgba(22,24,28,.50);
  --ease-expo:cubic-bezier(.16,1,.3,1);
  --ease-spring:cubic-bezier(.34,1.4,.56,1);

  --font:"Outfit",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
}

* { box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
html { scroll-behavior:smooth; }
body {
  margin:0; font-family:var(--font); color:var(--ink); background:var(--canvas);
  background-image:radial-gradient(rgba(22,24,28,.06) 1px, transparent 1.2px);
  background-size:26px 26px;
  -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
}
::selection { background:#FBE6A4; color:#16181C; }
button { font:inherit; color:inherit; cursor:pointer; background:none; border:0; }
a { color:inherit; }

/* ================= chrome (figma-like app bar) ================= */
.chrome {
  position:fixed; inset:0 0 auto 0; z-index:60; height:54px;
  display:flex; align-items:center; gap:14px; padding:0 18px;
  background:rgba(238,241,245,.78); backdrop-filter:blur(22px) saturate(150%);
  border-bottom:1px solid rgba(22,24,28,.07);
}
.chrome .logo { width:26px; height:26px; border-radius:50%; background:#fff; display:grid; place-items:center; box-shadow:0 4px 14px -6px rgba(22,24,28,.35); flex:none; }
.chrome .file { font-size:13.5px; font-weight:500; letter-spacing:-.01em; white-space:nowrap; }
.chrome .file small { font-weight:300; color:var(--ink-2); }
.chrome .ver { font-size:11px; font-weight:400; color:var(--ink-2); background:rgba(22,24,28,.055); border-radius:999px; padding:4px 9px; white-space:nowrap; }
.chrome nav { display:flex; gap:2px; margin:0 auto; background:rgba(255,255,255,.5); border-radius:999px; padding:3px; overflow-x:auto; scrollbar-width:none; max-width:62vw; }
.chrome nav::-webkit-scrollbar { display:none; }
.chrome nav a {
  font-size:12.5px; color:var(--ink-2); text-decoration:none; white-space:nowrap;
  padding:6px 12px; border-radius:999px; transition:color .25s, background .25s;
}
.chrome nav a:hover { color:var(--ink); }
.chrome nav a.on { background:#fff; color:var(--ink); box-shadow:0 2px 10px -3px rgba(22,24,28,.18); }
.chrome .acts { display:flex; align-items:center; gap:8px; margin-left:auto; }
.chipbtn {
  display:inline-flex; align-items:center; gap:6px; font-size:12px; color:var(--ink-2);
  background:rgba(255,255,255,.6); border-radius:999px; padding:7px 12px;
  transition:background .25s, color .25s;
}
.chipbtn:hover { background:#fff; color:var(--ink); }
.chipbtn.on { background:var(--ink); color:#fff; }
.chipbtn svg { width:13px; height:13px; }

/* ================= board / frames ================= */
.board { max-width:1560px; margin:0 auto; padding:96px 40px 140px; }
.frame { position:relative; margin:0 0 26px; }
.frame-label { display:flex; align-items:center; gap:8px; padding:0 2px 10px; }
.frame-label .fic { width:12px; height:12px; color:#5b8ef7; flex:none; }
.frame-label .fname { font-size:13px; font-weight:500; letter-spacing:.01em; }
.frame-label .fmeta { font-size:11px; font-weight:300; color:var(--muted); font-family:var(--mono); }
.panel {
  background:linear-gradient(180deg,rgba(255,255,255,.9),rgba(255,255,255,.66));
  border:1px solid var(--border-surface); border-radius:var(--r-28);
  box-shadow:var(--e-2); padding:44px 48px 48px;
}
.divider { display:flex; align-items:center; gap:14px; margin:64px 0; color:var(--faint); }
.divider .line { flex:1; height:1px; background:linear-gradient(90deg,transparent,rgba(22,24,28,.16),transparent); }
.divider .tick { font-size:10.5px; letter-spacing:.22em; font-weight:400; color:var(--muted); font-family:var(--mono); }

/* section head */
.shead { display:flex; align-items:flex-start; gap:26px; border-bottom:1px solid var(--hair); padding-bottom:30px; margin-bottom:34px; }
.shead .num {
  font-size:76px; line-height:.8; font-weight:200; letter-spacing:-.05em; color:var(--faint);
  min-width:118px;
}
.shead h2 { margin:0; font-size:40px; line-height:1.02; font-weight:400; letter-spacing:-.035em; }
.shead p { margin:10px 0 0; max-width:74ch; font-size:14px; line-height:1.65; font-weight:300; color:var(--ink-2); }
.shead .tags { margin-left:auto; display:flex; flex-direction:column; gap:6px; align-items:flex-end; }
.tag { font-size:11px; font-family:var(--mono); color:var(--ink-2); background:rgba(22,24,28,.045); border-radius:999px; padding:5px 10px; white-space:nowrap; }

.subhead { display:flex; align-items:baseline; gap:12px; margin:38px 0 18px; }
.subhead h3 { margin:0; font-size:19px; font-weight:500; letter-spacing:-.02em; }
.subhead .hint { font-size:12px; font-weight:300; color:var(--muted); }
.subhead:first-of-type { margin-top:0; }
.rule { font-size:10.5px; letter-spacing:.18em; text-transform:uppercase; color:var(--muted); font-weight:400; }

.grid { display:grid; gap:14px; }
.note {
  font-size:12.5px; line-height:1.6; font-weight:300; color:var(--ink-2);
  background:rgba(22,24,28,.03); border:1px solid var(--hair); border-radius:var(--r-18); padding:14px 16px;
}
.note b { font-weight:500; color:var(--ink); }
code, .mono { font-family:var(--mono); font-size:.92em; background:rgba(22,24,28,.05); border-radius:6px; padding:1px 5px; }

/* ================= DS-00 overview ================= */
.principles { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; }
.principle { background:var(--surface-2); border:1px solid rgba(255,255,255,.8); border-radius:var(--r-24); padding:22px; }
.principle .pn { font-size:11px; font-family:var(--mono); color:var(--amber-deep); }
.principle h4 { margin:10px 0 8px; font-size:16px; font-weight:500; letter-spacing:-.015em; }
.principle p { margin:0; font-size:12.5px; line-height:1.62; font-weight:300; color:var(--ink-2); }
.principle.cream { background:var(--surface-cream); }
.cols2 { display:grid; grid-template-columns:1.25fr .75fr; gap:14px; align-items:start; }
.dodont { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.dd { border-radius:var(--r-24); padding:20px 22px; border:1px solid rgba(255,255,255,.8); }
.dd.do { background:linear-gradient(175deg,rgba(255,255,255,.9),rgba(207,227,214,.55)); }
.dd.dont { background:linear-gradient(175deg,rgba(255,255,255,.9),rgba(252,214,210,.5)); }
.dd h5 { margin:0 0 12px; font-size:13px; font-weight:500; display:flex; align-items:center; gap:8px; }
.dd ul { margin:0; padding:0; list-style:none; display:grid; gap:9px; }
.dd li { font-size:12.5px; line-height:1.55; font-weight:300; color:var(--ink-2); padding-left:20px; position:relative; }
.dd li::before { position:absolute; left:0; top:1px; font-weight:500; }
.dd.do li::before { content:"✓"; color:#417C5C; }
.dd.dont li::before { content:"✕"; color:#C43A2B; }
.flowsteps { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; counter-reset:step; }
.flowsteps div { background:var(--surface-2); border:1px solid rgba(255,255,255,.8); border-radius:var(--r-18); padding:14px 16px; font-size:12px; line-height:1.55; font-weight:300; color:var(--ink-2); position:relative; }
.flowsteps div b { display:block; font-size:12.5px; font-weight:500; color:var(--ink); margin-bottom:4px; }
.flowsteps div::before {
  counter-increment:step; content:"0" counter(step);
  position:absolute; top:-9px; left:14px; font-family:var(--mono); font-size:10px;
  background:var(--ink); color:#fff; border-radius:999px; padding:3px 8px;
}

/* ================= DS-01 color ================= */
.scale-row { margin-bottom:22px; }
.scale-row .lab { display:flex; align-items:baseline; gap:10px; margin-bottom:8px; }
.scale-row .lab b { font-size:13.5px; font-weight:500; letter-spacing:-.01em; }
.scale-row .lab span { font-size:11px; font-family:var(--mono); color:var(--muted); }
.swatches { display:grid; grid-template-columns:repeat(9,1fr); gap:6px; }
.sw { border-radius:12px; overflow:hidden; cursor:copy; border:1px solid rgba(22,24,28,.06); background:#fff; }
.sw .c { height:64px; }
.sw .m { padding:7px 8px 8px; background:#fff; }
.sw .m b { display:block; font-size:10.5px; font-weight:500; }
.sw .m span { display:block; font-size:9.5px; font-family:var(--mono); color:var(--muted); text-transform:uppercase; }
.sw:hover .c { box-shadow:inset 0 0 0 2px rgba(22,24,28,.5); }
.sem-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; }
.sem-card { background:var(--surface-2); border:1px solid rgba(255,255,255,.8); border-radius:var(--r-24); padding:18px; }
.sem-card h4 { margin:0 0 4px; font-size:13.5px; font-weight:500; }
.sem-card .tok { font-size:10.5px; font-family:var(--mono); color:var(--muted); }
.sem-list { margin-top:12px; display:grid; gap:8px; }
.sem-item { display:flex; align-items:center; gap:10px; }
.sem-chip { width:34px; height:34px; border-radius:10px; border:1px solid rgba(22,24,28,.08); flex:none; }
.sem-item .n { font-size:12px; font-weight:400; }
.sem-item .v { margin-left:auto; font-size:10px; font-family:var(--mono); color:var(--muted); text-transform:uppercase; }
.status-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
.status-card { border-radius:var(--r-24); padding:18px; border:1px solid rgba(255,255,255,.8); }
.status-card h4 { margin:0; font-size:13.5px; font-weight:500; display:flex; align-items:center; gap:8px; }
.status-card .dot { width:8px; height:8px; border-radius:50%; }
.status-card .row { display:flex; gap:6px; margin-top:14px; }
.status-card .cell { flex:1; border-radius:12px; padding:10px 8px; text-align:center; }
.status-card .cell b { display:block; font-size:10.5px; font-weight:500; }
.status-card .cell span { font-size:9.5px; font-family:var(--mono); opacity:.72; }
.contrast { width:100%; border-collapse:collapse; font-size:12px; }
.contrast th { text-align:left; font-size:10.5px; letter-spacing:.14em; text-transform:uppercase; font-weight:400; color:var(--muted); padding:0 10px 8px 0; }
.contrast td { padding:9px 10px 9px 0; border-top:1px solid var(--hair); font-weight:300; color:var(--ink-2); }
.contrast td:first-child { color:var(--ink); font-weight:400; }
.contrast .pair { display:inline-flex; align-items:center; gap:8px; }
.contrast .sq { width:26px; height:18px; border-radius:5px; border:1px solid rgba(22,24,28,.1); }
.pill-ok { font-size:10.5px; font-family:var(--mono); border-radius:999px; padding:3px 8px; background:var(--ok-bg); color:var(--ok-text); }
.pill-warn { font-size:10.5px; font-family:var(--mono); border-radius:999px; padding:3px 8px; background:var(--warn-bg); color:var(--warn-text); }

/* ================= DS-02 typography ================= */
.type-rows { display:grid; gap:2px; }
.type-row { display:grid; grid-template-columns:150px minmax(0,1fr) 300px; gap:20px; align-items:center; padding:16px 6px; border-top:1px solid var(--hair); }
.type-row:first-child { border-top:0; }
.type-row .tn b { display:block; font-size:13px; font-weight:500; }
.type-row .tn span { font-size:10.5px; font-family:var(--mono); color:var(--muted); }
.type-row .spec { font-size:11px; font-family:var(--mono); color:var(--ink-2); line-height:1.9; }
.type-row .spec i { font-style:normal; color:var(--muted); }
.t-display { font-size:56px; line-height:1; font-weight:200; letter-spacing:-.045em; }
.t-h1 { font-size:40px; line-height:1.05; font-weight:400; letter-spacing:-.035em; }
.t-h2 { font-size:30px; line-height:1.1; font-weight:400; letter-spacing:-.03em; }
.t-h3 { font-size:19px; line-height:1.25; font-weight:500; letter-spacing:-.02em; }
.t-bodyl { font-size:15.5px; line-height:1.45; font-weight:400; letter-spacing:-.01em; }
.t-body { font-size:13.5px; line-height:1.5; font-weight:400; }
.t-small { font-size:12.5px; line-height:1.5; font-weight:300; }
.t-cap { font-size:11.5px; line-height:1.4; font-weight:300; }
.t-micro { font-size:10.5px; line-height:1.4; font-weight:300; letter-spacing:.02em; }
.t-num { font-size:34px; font-weight:200; letter-spacing:-.04em; font-variant-numeric:tabular-nums; }
.writ { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.writ .note { background:var(--surface-2); }
.writ h5 { margin:0 0 10px; font-size:13px; font-weight:500; }
.writ ul { margin:0; padding:0; list-style:none; display:grid; gap:8px; }
.writ li { font-size:12.5px; line-height:1.6; font-weight:300; color:var(--ink-2); }
.writ li b { font-weight:500; color:var(--ink); }
.example { border-radius:var(--r-18); padding:12px 14px; font-size:12.5px; margin-top:8px; }
.example.good { background:rgba(207,227,214,.5); color:var(--ok-text); }
.example.bad { background:rgba(252,214,210,.5); color:var(--co-800); text-decoration:line-through; }

/* ================= DS-03 foundations ================= */
.space-row { display:flex; align-items:flex-end; gap:18px; flex-wrap:wrap; }
.space-item { text-align:center; }
.space-item .bar { background:linear-gradient(180deg,var(--am-300),var(--am-500)); border-radius:4px; margin:0 auto; }
.space-item b { display:block; font-size:11px; font-weight:500; margin-top:8px; }
.space-item span { display:block; font-size:9.5px; font-family:var(--mono); color:var(--muted); }
.rad-row { display:flex; gap:16px; flex-wrap:wrap; align-items:flex-end; }
.rad-item { text-align:center; }
.rad-item .box { width:76px; height:76px; background:var(--surface-cream); border:1px solid rgba(255,255,255,.9); box-shadow:var(--e-1); margin:0 auto; }
.rad-item b { display:block; font-size:11px; font-weight:500; margin-top:8px; }
.rad-item span { display:block; font-size:9.5px; font-family:var(--mono); color:var(--muted); }
.elev-row { display:grid; grid-template-columns:repeat(5,1fr); gap:18px; }
.elev-item { text-align:center; }
.elev-item .box { height:96px; border-radius:var(--r-24); background:linear-gradient(180deg,rgba(255,255,255,.92),rgba(255,255,255,.7)); border:1px solid rgba(255,255,255,.9); display:grid; place-items:center; font-size:11px; font-family:var(--mono); color:var(--muted); }
.elev-item b { display:block; font-size:11.5px; font-weight:500; margin-top:10px; }
.elev-item span { display:block; font-size:9.5px; font-family:var(--mono); color:var(--muted); margin-top:2px; }
.motion-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; }
.motion-card { background:var(--surface-2); border:1px solid rgba(255,255,255,.8); border-radius:var(--r-24); padding:16px 18px; }
.motion-card b { font-size:12.5px; font-weight:500; }
.motion-card .bez { font-size:10px; font-family:var(--mono); color:var(--muted); margin-top:2px; }
.motion-card svg { width:100%; height:64px; margin-top:10px; }

/* ================= DS-04 usage ================= */
.anat { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.anat-card { background:var(--surface-2); border:1px solid rgba(255,255,255,.8); border-radius:var(--r-24); padding:22px; }
.anat-card h4 { margin:0 0 2px; font-size:13.5px; font-weight:500; }
.anat-card .sub { font-size:11px; font-family:var(--mono); color:var(--muted); }
.anat-card svg { width:100%; height:auto; margin-top:14px; }
.behav { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
.behav .note { background:var(--surface-2); }
.behav h5 { margin:0 0 8px; font-size:12.5px; font-weight:500; display:flex; gap:8px; align-items:center; }
.behav p { margin:0; font-size:12px; line-height:1.6; font-weight:300; color:var(--ink-2); }
.kbd { font-family:var(--mono); font-size:10px; background:#fff; border:1px solid var(--hair-strong); border-bottom-width:2px; border-radius:6px; padding:2px 6px; color:var(--ink-2); }

/* ================= DS-05 components ================= */
.matrix { width:100%; border-collapse:separate; border-spacing:0; }
.matrix th { text-align:left; font-size:10.5px; letter-spacing:.16em; text-transform:uppercase; font-weight:400; color:var(--muted); padding:0 14px 12px 0; }
.matrix td { padding:16px 14px 16px 0; border-top:1px solid var(--hair); vertical-align:middle; }
.matrix td:first-child { width:190px; }
.matrix .cname b { display:block; font-size:13px; font-weight:500; }
.matrix .cname span { display:block; font-size:10px; font-family:var(--mono); color:var(--muted); margin-top:2px; }
.matrix tr.tallrow td { padding-bottom:158px; }
.cellbox { min-height:52px; display:flex; align-items:center; gap:10px; }

/* --- live components (mirror production CSS) --- */
.btn {
  display:inline-flex; align-items:center; justify-content:center; gap:7px;
  border-radius:var(--r-full); padding:10px 20px; font-size:13px; white-space:nowrap;
