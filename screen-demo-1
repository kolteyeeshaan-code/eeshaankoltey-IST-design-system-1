                  <Badge
                    tone={c.status === "Pending" ? "amber" : c.status === "Blocked" ? "coral" : "plain"}
                  >
                    {c.status}
                  </Badge>
                  <button
                    type="button"
                    aria-label={`Actions for ${c.name}`}
                    onClick={() => setMenu(menu === c.name ? null : c.name)}
                    className="press flex h-7 w-7 items-center justify-center rounded-full text-faint hover:bg-[rgba(22,24,28,0.06)] hover:text-ink-2"
                  >
                    <Dots className="h-4 w-4" />
                  </button>
                </div>

                {menu === c.name && (
                  <div className="anim-pop absolute top-full right-0 z-30 mt-1 w-44 origin-top-right overflow-hidden rounded-2xl border border-white/80 bg-white/95 p-1.5 shadow-[0_24px_60px_-20px_rgba(22,24,28,0.35)] backdrop-blur-xl">
                    {["View application", "Send message", "Request documents"].map((a) => (
                      <button
                        key={a}
                        type="button"
                        onClick={() => {
                          setMenu(null);
                          toast(`${a} · ${c.name}`);
                        }}
                        className="w-full rounded-xl px-3 py-2 text-left text-[13px] text-ink-2 transition-colors duration-200 hover:bg-[rgba(22,24,28,0.04)] hover:text-ink"
                      >
                        {a}
                      </button>
