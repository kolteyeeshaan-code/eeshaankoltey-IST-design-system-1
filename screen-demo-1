            >
              <ArrowUpRight className="h-5 w-5" />
            </button>
          </div>
        </div>

        <Card className="flex-1 p-5">
          <CardHead
            title="Client Pipeline"
            sub="Recently updated applications"
            right={<RoundBtn label="Expand client pipeline" onClick={() => toast("Opened client directory")} />}
          />
          <ul className="mt-4 space-y-1">
            {CLIENTS.map((c) => (
              <li key={c.name} className="relative">
                <div className="group flex items-center gap-2.5 rounded-2xl px-1.5 py-2 transition-colors duration-300 hover:bg-white/70">
