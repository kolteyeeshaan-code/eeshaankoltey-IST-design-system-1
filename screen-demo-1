      {/* ================= Loan detail modal ================= */}
      <Modal
        open={!!openLoan}
        onClose={() => setOpenLoan(null)}
        title={openLoan ? `${openLoan.id} · ${openLoan.type}` : ""}
        sub={openLoan ? `${openLoan.applicant} — ${openLoan.property}` : ""}
        footer={
          <>
            <PillBtn tone="soft" onClick={() => setOpenLoan(null)} className="px-5 py-2.5">
