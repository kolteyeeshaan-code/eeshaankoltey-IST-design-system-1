            <RangeBar height={96} />
            <div className="relative h-2 border-t border-[rgba(22,24,28,0.1)]" aria-hidden="true">
              {WEEK.map((_, i) => (
                <span
                  key={i}
                  className="absolute top-0 h-[5px] w-px bg-[rgba(22,24,28,0.12)]"
                  style={{ left: `${(i / (WEEK.length - 1)) * 100}%` }}
