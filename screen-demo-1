              tone="dark"
              className="px-5 py-2.5"
              onClick={() => {
                toast(`Advanced ${openLoan?.id} to next stage`);
                setOpenLoan(null);
              }}
            >
              Advance stage
            </PillBtn>
          </>
        }
      >
        {openLoan && (
          <div className="pb-4">
            <div className="grid grid-cols-2 gap-2.5 sm:grid-cols-4">
              {[
                { k: "Amount", v: openLoan.amount },
                { k: "Stage", v: openLoan.stage },
                { k: "Est. Closing", v: openLoan.closing },
                { k: "Type", v: openLoan.type },
              ].map((s) => (
                <div key={s.k} className="rounded-2xl bg-[rgba(22,24,28,0.035)] px-3.5 py-3">
                  <p className="text-[11.5px] font-light text-muted">{s.k}</p>
                  <p className="mt-1 text-[14px] text-ink">{s.v}</p>
                </div>
              ))}
            </div>

            <div className="mt-4 rounded-2xl bg-[rgba(22,24,28,0.03)] p-4">
              <p className="text-[12.5px] font-light text-muted">Progress</p>
              <div className="mt-3 flex items-center gap-1.5">
                {["Application", "Processing", "Underwriting", "Appraisal", "Funded"].map((s, i) => {
                  const idx = ["Processing", "Underwriting", "Appraisal", "Funded", "Rejected"].indexOf(
                    openLoan.stage,
                  );
                  const done = i <= idx + 1;
                  return (
                    <div key={s} className="flex-1">
                      <div
                        className={cn(
                          "h-1.5 origin-left rounded-full transition-transform duration-[600ms] ease-out-expo",
                          done ? "bg-amber" : "bg-[rgba(22,24,28,0.08)]",
                        )}
                      />
                      <p className="mt-1.5 truncate text-[10.5px] font-light text-muted">{s}</p>
                    </div>
                  );
                })}
              </div>
            </div>

            <div className="mt-4 flex items-center gap-3 rounded-2xl bg-[rgba(22,24,28,0.03)] p-4">
              <Avatar src={openLoan.avatar} name={openLoan.applicant} size={44} />
              <div className="min-w-0">
                <p className="text-[14px] text-ink">{openLoan.applicant}</p>
                <p className="text-[12px] font-light text-muted">{openLoan.property}</p>
              </div>
              <div className="ml-auto flex gap-2">
                {ROW_TOOLS.slice(0, 3).map((t) => (
                  <RoundBtn
                    key={t.label}
                    icon={t.icon}
                    label={t.label}
                    size={36}
                    tone="soft"
                    onClick={() => toast(`${t.label} · ${openLoan.id}`)}
