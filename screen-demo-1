}

/* ---------------- row ---------------- */

function LoanRowItem({
  row,
  checked,
  onToggle,
  onOpen,
  onTool,
}: {
  row: LoanRow;
  checked: boolean;
  onToggle: () => void;
  onOpen: () => void;
  onTool: (t: string) => void;
}) {
  const [hover, setHover] = useState(false);
  const tone = STAGE_TONE[row.stage];

  return (
    <li
      className="group relative"
      onMouseEnter={() => setHover(true)}
      onMouseLeave={() => setHover(false)}
    >
      <div
        className={cn(
          "grid grid-cols-[28px_1.5fr_1.1fr_1fr_1fr_1.3fr_36px] items-center gap-3 rounded-2xl px-2 py-3 transition-colors duration-300",
          checked ? "bg-white/80" : "hover:bg-white/60",
        )}
      >
        <button
          type="button"
          role="checkbox"
          aria-checked={checked}
          aria-label={`Select ${row.id}`}
          onClick={onToggle}
          className={cn(
            "press flex h-[18px] w-[18px] items-center justify-center rounded-full border transition-colors duration-300",
            checked ? "border-ink bg-ink text-white" : "border-[rgba(22,24,28,0.16)] bg-[rgba(22,24,28,0.04)]",
          )}
        >
          <span
            className="h-[7px] w-[7px] rounded-full bg-white transition-transform duration-[400ms] ease-spring"
            style={{ transform: checked ? "scale(1)" : "scale(0)" }}
          />
        </button>

        <button type="button" onClick={onOpen} className="truncate text-left text-[13px] text-ink hover:underline">
          {row.id} · {row.type}
        </button>

        <span>
          <Badge tone="neutral" className="bg-[rgba(22,24,28,0.045)]">
            <i
              className={cn(
                "-ml-0.5 h-[6px] w-[6px] rounded-full",
                tone === "amber" && "bg-amber",
                tone === "coral" && "bg-coral",
                tone === "mint" && "bg-[#7bb694]",
                tone === "neutral" && "bg-faint",
              )}
            />
            {row.stage}
          </Badge>
        </span>

        <span className="text-[13px] text-ink">{row.amount}</span>
        <span className="text-[13px] font-light text-ink-2">{row.closing}</span>
        <div className="min-w-0">
          <p className="truncate text-[13px] text-ink">{row.applicant}</p>
          <p className="truncate text-[11.5px] font-light text-muted">{row.property}</p>
        </div>

        <RoundBtn
          icon={<Upload />}
          label={`Upload documents for ${row.id}`}
          size={30}
          tone="soft"
          onClick={() => onTool("Upload documents")}
        />
      </div>

      {/* floating hover toolbar */}
      <div
        aria-hidden={!hover}
        className="pointer-events-none absolute inset-y-0 left-1/2 z-20 flex items-center"
        style={{ willChange: "transform, opacity" }}
      >
        <div
          className={cn(
            "flex items-center gap-1 rounded-full bg-white/90 p-1.5 shadow-[0_18px_40px_-18px_rgba(22,24,28,0.55)] backdrop-blur-xl transition-all duration-[420ms] ease-out-expo",
            hover ? "pointer-events-auto translate-x-[-50%] translate-y-0 scale-100 opacity-100" : "translate-x-[-50%] translate-y-1.5 scale-90 opacity-0",
          )}
        >
          {ROW_TOOLS.map((t) => (
            <button
              key={t.label}
              type="button"
              aria-label={t.label}
              title={t.label}
              onClick={() => onTool(t.label)}
              className="press flex h-8 w-8 items-center justify-center rounded-full text-ink-2 hover:bg-[rgba(22,24,28,0.06)] hover:text-ink"
            >
              <span className="h-[16px] w-[16px] [&>svg]:h-full [&>svg]:w-full">{t.icon}</span>
            </button>
          ))}
        </div>
      </div>
    </li>
  );
}

/* ---------------- alternate bar view ---------------- */

function BarFlow({ flow }: { flow: (typeof SANKEY)[FlowTab] }) {
  const all = [...flow.sources, ...flow.stages, ...flow.outcomes];
  const max = Math.max(...all.map((n) => n.weight));
  return (
    <div className="anim-fade-up grid grid-cols-1 gap-3 pt-2 sm:grid-cols-3">
      {[flow.sources, flow.stages, flow.outcomes].map((group, gi) => (
        <div key={gi} className="space-y-2.5">
          {group.map((n) => (
            <div key={n.label}>
              <div className="flex items-baseline justify-between">
                <span className="text-[12.5px] text-ink">{n.value}</span>
                <span className="text-[11.5px] font-light text-muted">{n.label}</span>
              </div>
              <div className="mt-1.5 h-2 overflow-hidden rounded-full bg-[rgba(22,24,28,0.05)]">
                <div
                  className={cn(
                    "h-full origin-left rounded-full transition-transform duration-[900ms] ease-out-expo",
                    gi === 2 && "tone" in n && (n as { tone?: string }).tone === "coral"
                      ? "bg-coral"
                      : gi === 1
                        ? "bg-[#C9D5F2]"
                        : "bg-amber",
                  )}
                  style={{ transform: `scaleX(${n.weight / max})` }}
                />
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  );
}
